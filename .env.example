# Razorpay Payment Gateway Credentials (Add these in Railway -> Variables or .env.local)
# Get your keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Organizer Admin Portal Passcode (for /admin registration database & CSV export)
ADMIN_PASSCODE=DDR2027ADMIN

# Optional: Custom persistent volume path on Railway (e.g., /data/registrations.json)
# REGISTRATIONS_DATA_PATH=/data/registrations.json

# Optional: Webhook URL (e.g., Google Sheets Apps Script / Make / Zapier) to auto-forward every registration
# REGISTRATION_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxx/exec
